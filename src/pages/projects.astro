---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sampleProjects } from '../data/site';
---

<BaseLayout
  title="Projects"
  description="Fictional residential, commercial, and hospitality project samples for layout preview."
>
  <header class="page-intro shell">
    <p class="eyebrow">Projects · Fictional samples</p><h1>
      Spaces worth<br /><em>imagining.</em>
    </h1><p class="page-lede">
      These concepts demonstrate gallery structure only. Images are original
      generated studies of fictional spaces, not photographs of completed work.
    </p>
  </header>
  <section class="foundation-section shell" data-reveal>
    <div class="project-grid">
      {
        sampleProjects.map((project) => (
          <article class="project-card">
            <>
              <img
                class="project-image"
                src={project.image}
                alt={project.imageAlt}
                width="1440"
                height="960"
                loading="lazy"
              />
              <p class="eyebrow">Fictional sample · {project.category}</p>
              <h2>{project.title}</h2>
              <p>{project.description}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="section-band">
    <div class="shell section-split">
      <h2>Real places will tell the story.</h2><div>
        <p>
          Approved project details, photography, and image rights will replace
          these fictional examples before public launch.
        </p><a class="text-link" href="/contact"
          >Discuss a project <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </section>
</BaseLayout>

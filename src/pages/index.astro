---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="foundation-hero">
    <div class="shell foundation-grid">
      <div class="foundation-copy">
        <p class="eyebrow">Residential · Commercial · Hospitality</p>
        <h1>Interiors with<br /><em>room to belong.</em></h1>
        <p class="lede">
          A calm, editorial foundation for an interior studio. Brand facts,
          project stories, and final imagery remain clearly marked until
          approved.
        </p>
        <a class="button" href="/contact">Start a conversation</a>
      </div>
      <div
        class="threshold-study"
        aria-label="Abstract architectural threshold study"
      >
        <span class="threshold-sun"></span>
        <span class="threshold-wall"></span>
        <span class="threshold-door"></span>
        <span class="threshold-floor"></span>
        <p>Original image study arrives in chunk 2</p>
      </div>
    </div>
    <div class="shell foundation-note">
      <span>01</span>
      <p>Foundation preview</p>
      <p>Visual system · Navigation · Responsive shell</p>
    </div>
  </section>

  <section class="foundation-section shell">
    <p class="eyebrow">Quietly considered</p>
    <div class="section-split">
      <h2>A warm framework, ready for real stories.</h2>
      <div>
        <p>
          This first chunk establishes type, color, space, navigation, metadata,
          and accessibility. Service copy and project claims will remain
          fictional or visibly marked until supplied.
        </p>
        <a class="text-link" href="/about"
          >Foundation details <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </section>
</BaseLayout>

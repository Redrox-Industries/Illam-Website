---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sampleProjects, services } from '../data/site';
---

<BaseLayout>
  <section class="foundation-hero">
    <div class="shell foundation-grid">
      <div class="foundation-copy">
        <p class="eyebrow">Interior design · Studio preview</p><h1>
          Interiors with<br /><em>room to belong.</em>
        </h1><p class="lede">
          A considered space begins with listening. Explore a preview of the
          studio approach while brand details and real work await approval.
        </p><a class="button" href="/contact">Start a conversation</a>
      </div><div
        class="threshold-study"
        role="img"
        aria-label="Abstract architectural study of a doorway, sun, and floor"
      >
        <span class="threshold-sun"></span><span class="threshold-wall"
        ></span><span class="threshold-door"></span><span
          class="threshold-floor"></span><p>
          Abstract study · Original imagery planned
        </p>
      </div>
    </div><div class="shell foundation-note">
      <span>01</span><p>Spaces for living and gathering</p><p>
        Concept site · Facts pending
      </p>
    </div>
  </section>
  <section class="foundation-section shell" aria-labelledby="intro-heading">
    <p class="eyebrow">The studio · Preview</p><div class="section-split">
      <h2 id="intro-heading">A quieter way to shape space.</h2><div>
        <p>
          Thoughtful interiors bring use, atmosphere, and detail together. This
          studio introduction is placeholder copy until the business story is
          supplied.
        </p><a class="text-link" href="/about"
          >About the studio <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </section>
  <section class="section-band" aria-labelledby="services-heading">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">What we explore</p><h2 id="services-heading">
            Design for every kind of space.
          </h2>
        </div><a class="text-link" href="/services"
          >All services <span aria-hidden="true">↗</span></a
        >
      </div><div class="service-list">
        {
          services.slice(0, 3).map((service) => (
            <article class="service-row">
              <>
                <span>{service.number}</span>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
              </>
            </article>
          ))
        }
      </div><p class="content-note">
        Service descriptions are placeholders, not confirmed offerings.
      </p>
    </div>
  </section>
  <section class="foundation-section shell" aria-labelledby="projects-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected studies</p><h2 id="projects-heading">
          Space, in possibility.
        </h2>
      </div><a class="text-link" href="/projects"
        >View sample gallery <span aria-hidden="true">↗</span></a
      >
    </div><div class="project-grid">
      {
        sampleProjects.slice(0, 2).map((project) => (
          <article class="project-card">
            <>
              <div class={`project-art ${project.tone}`} aria-hidden="true">
                <span />
              </div>
              <p class="eyebrow">Fictional sample · {project.category}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="section-band" aria-labelledby="process-heading">
    <div class="shell process-grid">
      <div>
        <p class="eyebrow">A simple path</p><h2 id="process-heading">
          From first thought to final detail.
        </h2>
      </div><ol class="process-list">
        <li>
          <span>01</span><div>
            <h3>Listen</h3><p>
              Start with the people, space, and practical needs.
            </p>
          </div>
        </li><li>
          <span>02</span><div>
            <h3>Explore</h3><p>
              Develop a direction through layout, material, and mood.
            </p>
          </div>
        </li><li>
          <span>03</span><div>
            <h3>Refine</h3><p>
              Bring decisions together with care and clarity.
            </p>
          </div>
        </li>
      </ol>
    </div><div class="shell">
      <p class="content-note">
        Illustrative process only. Final workflow requires studio approval.
      </p>
    </div>
  </section>
  <section class="foundation-section shell contact-callout">
    <p class="eyebrow">Your space, next</p><h2>
      What could your space become?
    </h2><a class="button" href="/contact">Contact the studio</a>
  </section>
</BaseLayout>

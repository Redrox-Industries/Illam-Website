---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import DoorEntry from '../components/DoorEntry.astro';
import { sampleProjects, services } from '../data/site';
---

<BaseLayout>
  <DoorEntry image="/images/sirpi-doorway-entry.webp" />
  <section
    class="foundation-section shell arrival-section"
    aria-labelledby="intro-heading"
    data-reveal
    id="arrival"
  >
    <p class="eyebrow">01 · Arrival</p><div class="section-split">
      <h2 id="intro-heading">A home begins with how it welcomes you.</h2><div>
        <p>
          Sirpi brings material, light, and everyday rituals into one considered
          interior language. Studio history and business details remain pending
          approval.
        </p><a class="text-link" href="/about"
          >About the studio <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </section>
  <section class="section-band" aria-labelledby="services-heading" data-reveal>
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 · Craft</p><h2 id="services-heading">
            Tradition, considered for today.
          </h2>
        </div><a class="text-link" href="/services"
          >All services <span aria-hidden="true">↗</span></a
        >
      </div><div class="service-list">
        {
          services.slice(0, 3).map((service) => (
            <article class="service-row">
              <>
                <span>{service.number}</span>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
              </>
            </article>
          ))
        }
      </div><p class="content-note">
        Service descriptions are placeholders, not confirmed offerings.
      </p>
    </div>
  </section>
  <section
    class="foundation-section shell"
    aria-labelledby="projects-heading"
    data-reveal
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 · Rooms</p><h2 id="projects-heading">
          Rooms with memory and purpose.
        </h2>
      </div><a class="text-link" href="/projects"
        >View sample gallery <span aria-hidden="true">↗</span></a
      >
    </div><div class="project-grid">
      {
        sampleProjects.slice(0, 2).map((project) => (
          <article class="project-card">
            <>
              <img
                class="project-image"
                src={project.image}
                alt={project.imageAlt}
                width="1440"
                height="960"
                loading="lazy"
              />
              <p class="eyebrow">Fictional sample · {project.category}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section
    class="section-band"
    aria-labelledby="comparison-heading"
    data-reveal
  >
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">04 · Transformation</p><h2 id="comparison-heading">
            See heritage take root.
          </h2>
        </div>
      </div>
      <BeforeAfter />
    </div>
  </section>
  <section class="section-band" aria-labelledby="process-heading" data-reveal>
    <div class="shell process-grid">
      <div>
        <p class="eyebrow">05 · Process</p><h2 id="process-heading">
          From first conversation to final detail.
        </h2>
      </div><ol class="process-list">
        <li>
          <span>01</span><div>
            <h3>Listen</h3><p>
              Start with the people, space, and practical needs.
            </p>
          </div>
        </li><li>
          <span>02</span><div>
            <h3>Explore</h3><p>
              Develop a direction through layout, material, and mood.
            </p>
          </div>
        </li><li>
          <span>03</span><div>
            <h3>Refine</h3><p>
              Bring decisions together with care and clarity.
            </p>
          </div>
        </li>
      </ol>
    </div><div class="shell">
      <p class="content-note">
        Illustrative process only. Final workflow requires studio approval.
      </p>
    </div>
  </section>
  <section class="foundation-section shell contact-callout">
    <p class="eyebrow">06 · Invitation</p><h2>
      What will your home remember?
    </h2><a class="button" href="/contact">Contact the studio</a>
  </section>
</BaseLayout>

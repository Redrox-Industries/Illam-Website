---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy"
  description="Privacy status for the Sirpi Interiors website."
>
  <header class="page-intro shell">
    <p class="eyebrow">Privacy</p>
    <h1>Privacy information<br /><em>is being prepared.</em></h1>
    <p class="page-lede">
      The enquiry form is disabled and cannot send or store a message. Approved
      business and privacy details are still pending.
    </p>
  </header>
  <section class="foundation-section shell privacy-content">
    <h2>Before enquiries open.</h2>
    <p>
      The studio will publish an approved privacy notice explaining what enquiry
      details are collected, how they are used, where they are sent, how long
      they are kept, and how to request their removal. Enquiry delivery will
      remain unavailable until that notice and the destination are confirmed.
    </p>
    <a class="text-link" href="/contact">Return to contact</a>
  </section>
</BaseLayout>

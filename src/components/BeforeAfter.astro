<div class="comparison" data-comparison style="--split: 50%">
  <div class="comparison-images">
    <img
      src="/images/concept-before.webp"
      width="1440"
      height="960"
      loading="lazy"
      alt="Fictional before concept: an empty room with a rear window and grey tile floor"
    />
    <img
      class="comparison-after"
      src="/images/concept-after.webp"
      width="1440"
      height="960"
      loading="lazy"
      alt="Fictional after concept: the same room with warm finishes and comfortable furniture"
    />
    <input
      id="concept-split"
      class="comparison-range"
      type="range"
      min="0"
      max="100"
      value="50"
      aria-label="Reveal designed concept"
      aria-describedby="comparison-note"
      data-comparison-range
    />
    <span class="comparison-divider" aria-hidden="true"></span>
    <span class="comparison-badge before" aria-hidden="true">Before</span>
    <span class="comparison-badge after" aria-hidden="true">After</span>
  </div>
  <p id="comparison-note" class="content-note">
    Drag across the image, or use arrow keys, to compare. Fictional concept
    study; neither image depicts a completed project.
  </p>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-comparison]')
    .forEach((comparison) => {
      const range = comparison.querySelector<HTMLInputElement>(
        '[data-comparison-range]',
      );
      range?.addEventListener('input', () => {
        comparison.style.setProperty('--split', `${range.value}%`);
      });
    });
</script>

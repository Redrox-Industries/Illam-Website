---
import { primaryNavigation, site } from '../data/site';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === href : currentPath.startsWith(href);
---

<header class="site-header" data-header>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="header-inner shell">
    <div class="wordmark-group">
      <a class="wordmark" href="/" aria-label={`${site.name} home`}>
        <span>{site.name}</span>
        <small>Interior design · Preview</small>
      </a>
      <a class="parent-brand" href={site.parentUrl}>
        A product by {site.parentCompany}
      </a>
    </div>

    <button
      class="menu-toggle"
      type="button"
      aria-controls="site-navigation"
      aria-expanded="false"
      data-menu-toggle
    >
      <span>Menu</span>
      <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav
      id="site-navigation"
      class="site-navigation"
      aria-label="Primary"
      data-menu
    >
      <ul>
        {
          primaryNavigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

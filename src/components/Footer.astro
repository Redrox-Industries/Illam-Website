---
import { primaryNavigation, site } from '../data/site';
---

<footer class="site-footer" data-reveal>
  <div class="shell">
    <div class="footer-intro">
      <p class="eyebrow">
        The next space begins here <span>05 / Contact</span>
      </p>
      <div class="footer-intro-row">
        <h2>Have a space<br /><em>in mind?</em></h2>
        <a class="footer-cta" href="/contact">
          Explore contact page <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="footer-details">
      <div class="footer-identity">
        <p class="footer-label">Sirpi Interiors</p>
        <div class="footer-brand">
          <img
            src={site.headerLogo}
            alt={site.name}
            width="500"
            height="500"
            loading="lazy"
          />
        </div>
        <p>A product by <a href={site.parentUrl}>{site.parentCompany}</a>.</p>
      </div>
      <div class="footer-nav">
        <p class="footer-label">Explore</p>
        <nav aria-label="Footer">
          <ul>
            {
              primaryNavigation.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <div class="footer-contact">
        <p class="footer-label">Contact placeholders</p>
        <p>{site.email}</p>
        <p>{site.phone}</p>
        <p>{site.location}</p>
      </div>
    </div>
    <div class="footer-base">
      <p>© {new Date().getFullYear()} {site.name}.</p>
      <a href="/privacy">Privacy</a>
      <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>
